{
  "name": "icanboogie/bind-prototype",
  "type": "library",
  "description": "Binds icanboogie/prototype to ICanBoogie.",
  "keywords": [
    "prototype",
    "icanboogie"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/bind-prototype/issues",
    "source": "https://github.com/ICanBoogie/bind-prototype"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true,
    "allow-plugins": {
      "icanboogie/autoconfig": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "icanboogie/icanboogie": "^7.0",
    "icanboogie/prototype": "^7.0"
  },
  "require-dev": {
    "icanboogie/console": "^7.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\Binding\\Prototype\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\Binding\\Prototype\\": "tests/lib"
    }
  },
  "extra": {
    "icanboogie": {
      "config-path": "config",
      "config-constructor": {
        "ICanBoogie\\Prototype\\Config": "ICanBoogie\\Prototype\\ConfigBuilder"
      }
    }
  }
}
